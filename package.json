{
  "name": "dsh-long-memory",
  "version": "0.13.0",
  "type": "module",
  "description": "Automatic long-term memory for DeepSeek Harness: distills each finished turn into global and per-workspace facts and feeds them back into later sessions.",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "cordis",
    "plugin",
    "memory",
    "long-term-memory"
  ],
  "author": "baixiaoyin666",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/baixiaoyin666/dsh-long-memory.git"
  },
  "homepage": "https://github.com/baixiaoyin666/dsh-long-memory#readme",
  "bugs": {
    "url": "https://github.com/baixiaoyin666/dsh-long-memory/issues"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "lib/memory.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  }
}
